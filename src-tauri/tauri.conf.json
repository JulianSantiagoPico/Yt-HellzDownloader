{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YT Playlist Downloader",
  "version": "0.1.0",
  "identifier": "com.ytplaylistdownloader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "YT Playlist Downloader", "width": 900, "height": 680, "minWidth": 640, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["binaries/*.exe"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
